{
  "expo": {
    "name": "Love Meter",
    "slug": "love-meter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/new-images/splash-icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "Allow access to save drawings to your photo library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/new-images/splash-icon.png",
        "backgroundColor": "#000"
      },
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "package": "com.devac95585.lovemeter"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/new-images/splash-screen.png",
          "resizeMode": "cover",
          "backgroundColor": "#000"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "5608c9f4-a176-4476-9044-369b7f7d09e5"
      }
    }
  }
}
